generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteSetting {
  key   String @id
  value String
}

model User {
  id              String    @id @default(cuid())
  anonId          String    @unique
  displayName     String?
  recoveryKeyHash String?
  createdAt       DateTime  @default(now())
  postCount       Int       @default(0)
  badge           String    @default("Newbie")
  role            String    @default("user")
  status          String    @default("New user")
  banned          Boolean   @default(false)
  suspendedUntil  DateTime?

  avatarId        String?
  avatar          Avatar?   @relation("UserAvatar", fields: [avatarId], references: [id])
  bannerUrl       String?
  signature       String?   @db.Text
  bio             String?   @db.Text
  selectedGifId   String?
  profileGif      ProfileGif? @relation("UserProfileGif", fields: [selectedGifId], references: [id])
  profileTheme    String?   @default("default")

  posts           Post[]
  warnings        Warning[]
  modActions      ModerationAction[] @relation("ModeratorActions")
  boardMods       BoardModerator[]
  customizations  ProfileCustomization?
  avatars         Avatar[] @relation("UserAvatars")
  profileGifs     ProfileGif[] @relation("UserProfileGifs")
  moderationLogs  ModerationLog[]
}

model Board {
  id          String   @id
  name        String
  description String
  rules       String?
  status      String   @default("public")
  createdAt   DateTime @default(now())
  threads     Thread[]
  moderators  BoardModerator[]
}

model Thread {
  id        Int      @id @default(autoincrement())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id])
  subject   String?
  locked    Boolean  @default(false)
  sticky    Boolean  @default(false)
  archived  Boolean  @default(false)
  views     Int      @default(0)
  bumpedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          Int       @id @default(autoincrement())
  postNumber  String    @unique
  threadId    Int
  thread      Thread    @relation(fields: [threadId], references: [id])
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  displayName String    @default("Anonymous")
  content     String
  replyToId   Int?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  hidden      Boolean   @default(false)
  status      String    @default("active")
  reports     Report[]
}

model Report {
  id         Int      @id @default(autoincrement())
  postId     Int
  post       Post     @relation(fields: [postId], references: [id])
  reason     String
  details    String?  @db.Text
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  resolvedBy String?
}

model Warning {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  reason      String
  duration    String
  expiresAt   DateTime?
  moderatorId String?
  createdAt   DateTime  @default(now())
}

model BoardModerator {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  permissions String[] @default(["VIEW_REPORTS", "MODERATE_POSTS", "LOCK_THREADS"])
  createdAt   DateTime @default(now())

  @@unique([boardId, userId])
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  color       String   @default("#808080")
  description String?
  level       Int      @default(0)
  requirement String?
  createdAt   DateTime @default(now())
}

model ModerationAction {
  id          Int      @id @default(autoincrement())
  moderatorId String?
  moderator   User?    @relation("ModeratorActions", fields: [moderatorId], references: [id])
  action      String
  targetType  String
  targetId    String
  reason      String?  @db.Text
  createdAt   DateTime @default(now())
}

model Widget {
  id          Int      @id @default(autoincrement())
  slot        String
  type        String   @default("banner")
  imageUrl    String?
  linkUrl     String?
  altText     String?
  htmlContent String?  @db.Text
  active      Boolean  @default(true)
  order       Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
}

model Avatar {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserAvatars", fields: [userId], references: [id])
  primaryUser     User?     @relation("UserAvatar")
  fileName        String
  url             String
  size            Int
  mimeType        String
  width           Int?
  height          Int?
  status          String    @default("PENDING")
  moderationNote  String?   @db.Text
  uploadedAt      DateTime  @default(now())
  moderatedAt     DateTime?
  moderatedBy     String?
  aiReviewId      String?   @unique
  aiReview        AIModerationResult? @relation(fields: [aiReviewId], references: [id])

  @@index([userId])
  @@index([status])
}

model ProfileCustomization {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  theme           String   @default("default")
  accentColor     String   @default("#0066cc")
  showPostCount   Boolean  @default(true)
  showJoinDate    Boolean  @default(true)
  profileLayout   String   @default("standard")
  updatedAt       DateTime @updatedAt
}

model ProfileGif {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserProfileGifs", fields: [userId], references: [id])
  primaryUser User?     @relation("UserProfileGif")
  gifId       String
  gifUrl      String
  gifTitle    String
  category    String
  addedAt     DateTime  @default(now())
  active      Boolean   @default(true)
  status      String    @default("APPROVED")

  @@index([userId])
  @@unique([userId, gifId])
}

model AIModerationResult {
  id              String   @id @default(cuid())
  targetType      String
  targetId        String
  userId          String
  decision        String   @default("UNCERTAIN")
  confidence     Float
  reasons         String[] @default([])
  flaggedKeywords String[] @default([])
  details         String?  @db.Text
  aiModel         String   @default("default-moderation-v1")
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewDecision  String?
  reviewNotes     String?  @db.Text
  createdAt       DateTime @default(now())
  avatar          Avatar?

  @@index([targetType, targetId])
  @@index([decision])
  @@index([userId])
}

model ModerationLog {
  id             String   @id @default(cuid())
  moderatorId    String?
  moderator      User?    @relation(fields: [moderatorId], references: [id])
  action         String
  targetType     String
  targetId       String
  targetUserId   String
  reason         String?  @db.Text
  previousState  String?  @db.Text
  newState       String?  @db.Text
  aiDecisionUsed Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([targetUserId])
  @@index([moderatorId])
  @@index([createdAt])
}
