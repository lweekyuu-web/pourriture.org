generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteSetting {
  key   String @id
  value String
}

model User {
  id               String    @id @default(cuid())
  anonId           String    @unique
  displayName      String?
  recoveryKeyHash  String?
  bio              String?
  signature        String?
  avatarUrl        String?
  bannerUrl        String?
  profileTheme     String    @default("classic")
  profileLayout    String    @default("compact")
  profileNameColor String    @default("#117743")
  profileNameStyle String    @default("normal")
  profileGifUrl    String?
  avatarStatus     String    @default("approved")
  bannerStatus     String    @default("approved")
  avatarAiFlagged  Boolean   @default(false)
  bannerAiFlagged  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  lastLoginAt      DateTime?
  lastLoginIp      String?
  postCount        Int       @default(0)
  badge            String    @default("Newbie")
  role             String    @default("user")
  status           String    @default("New user")
  banned           Boolean   @default(false)
  suspendedUntil   DateTime?
  adminTitle       String?
  adminPermissions String[]  @default([])
  posts            Post[]
  warnings         Warning[]
  modActions       ModerationAction[] @relation("ModeratorActions")
  boardMods        BoardModerator[]
  sentMessages     DirectMessage[] @relation("MessageSender")
  receivedMessages DirectMessage[] @relation("MessageRecipient")
  badges            UserBadge[]
  friendRequestsSent     Friendship[] @relation("FriendshipRequester")
  friendRequestsReceived Friendship[] @relation("FriendshipRecipient")
}

model Board {
  id          String   @id
  name        String
  description String
  rules       String?
  status      String   @default("public")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  threads     Thread[]
  moderators  BoardModerator[]
}

model BoardRequest {
  id              Int      @id @default(autoincrement())
  boardId         String
  name            String
  description     String
  rules           String?
  requesterAnonId String?
  reason          String?
  status          String   @default("pending")
  adminNote       String?
  createdAt       DateTime @default(now())
  reviewedAt      DateTime?
}

model Thread {
  id        Int      @id @default(autoincrement())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id])
  subject   String?
  locked    Boolean  @default(false)
  sticky    Boolean  @default(false)
  archived  Boolean  @default(false)
  views     Int      @default(0)
  bumpedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          Int       @id @default(autoincrement())
  postNumber  String    @unique
  threadId    Int
  thread      Thread    @relation(fields: [threadId], references: [id])
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  displayName String    @default("Anonymous")
  content     String
  gifUrl      String?
  imageUrl    String?
  replyToId   Int?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  hidden      Boolean   @default(false)
  status      String    @default("active")
  reports     Report[]
}

model Report {
  id         Int      @id @default(autoincrement())
  postId     Int
  post       Post     @relation(fields: [postId], references: [id])
  reason     String
  details    String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  resolvedBy String?
}

model Warning {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  reason      String
  duration    String
  expiresAt   DateTime?
  moderatorId String?
  createdAt   DateTime  @default(now())
}

model BoardModerator {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  permissions String[] @default(["VIEW_REPORTS", "MODERATE_POSTS", "LOCK_THREADS"])
  createdAt   DateTime @default(now())
  @@unique([boardId, userId])
}

model Badge {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  color       String     @default("#808080")
  description String?
  level       Int        @default(0)
  requirement String?
  createdAt   DateTime   @default(now())
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   Int
  assignedAt DateTime @default(now())
  assignedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  @@unique([userId, badgeId])
  @@index([badgeId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  recipientId String
  status      String   @default("pending")
  topFriend   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester  User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient  User     @relation("FriendshipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

model ModerationAction {
  id          Int      @id @default(autoincrement())
  moderatorId String?
  moderator   User?    @relation("ModeratorActions", fields: [moderatorId], references: [id])
  action      String
  targetType  String
  targetId    String
  reason      String?
  createdAt   DateTime @default(now())
}

model DirectMessage {
  id          Int      @id @default(autoincrement())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  subject     String   @default("Contact")
  content     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

model Widget {
  id          Int      @id @default(autoincrement())
  slot        String
  type        String   @default("banner")
  imageUrl    String?
  linkUrl     String?
  altText     String?
  htmlContent String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
}
