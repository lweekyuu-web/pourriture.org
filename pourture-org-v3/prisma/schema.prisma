generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SiteSetting {
  key   String @id
  value String
}

model User {
  id              String    @id @default(cuid())
  anonId          String    @unique
  displayName     String?
  recoveryKeyHash String?
  createdAt       DateTime  @default(now())
  postCount       Int       @default(0)
  badge           String    @default("Newbie")
  banned          Boolean   @default(false)
  posts           Post[]
}

model Board {
  id          String   @id
  name        String
  description String
  rules       String?
  status      String   @default("public")
  createdAt   DateTime @default(now())
  threads     Thread[]
}

model Thread {
  id        Int      @id @default(autoincrement())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id])
  subject   String?
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id          Int       @id @default(autoincrement())
  postNumber  String    @unique
  threadId    Int
  thread      Thread    @relation(fields: [threadId], references: [id])
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id])
  displayName String    @default("Anonymous")
  content     String
  replyToId   Int?
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  hidden      Boolean   @default(false)
  reports     Report[]
}

model Report {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  reason    String
  details   String?
  createdAt DateTime @default(now())
  resolved  Boolean  @default(false)
}

model Widget {
  id          Int      @id @default(autoincrement())
  slot        String   // home_top | home_bottom | board_top | thread_top | thread_bottom
  type        String   @default("banner") // banner | html
  imageUrl    String?
  linkUrl     String?
  altText     String?
  htmlContent String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
}

model ModerationAction {
  id         Int      @id @default(autoincrement())
  action     String
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime @default(now())
}
